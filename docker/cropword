#!/opt/renderer/bin/python
"""cropword PDF PAGE X0 Y0 X1 Y1 OUT.png EXPECT_PAGES [wide|page] [--text FILE --offset N --len M]

Crop one handwritten word out of a PDF page and save it as a small greyscale
PNG. PAGE is 1-based; the box is in thousandths of the page width/height
(Claude's rough estimate, so it is padded generously). EXPECT_PAGES guards the
page mapping: when it is > 0 and the PDF has a different number of pages
(a tall reMarkable page was sliced, say) we exit 3 instead of cropping the
wrong page. With the optional 10th argument `wide` the output is the whole line
(full page width, a little above and below) with the word's box outlined in red,
so the owner sees the surrounding words. With --text/--offset/--len (the page transcript and where the word sits in it) the word is
located from the handwritten line structure (docker/handwriting_locate.py), which is far
more accurate than Claude's rough box; Claude's box is only the fallback (a box of
0 0 1 1 means "none"). Exit codes: 0 ok, 2 usage/bad input, 3 page-count mismatch,
4 no usable position.
"""
import sys

import pypdfium2 as pdfium

MAX_W, MAX_H = 520, 180


def main() -> int:
    argv = sys.argv[1:]
    opts = {}
    wide = False
    page_mode = False
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "wide":
            wide = True
        elif a == "page":
            page_mode = True
        elif a in ("--text", "--offset", "--len") and i + 1 < len(argv):
            opts[a] = argv[i + 1]
            i += 1
        else:
            pos.append(a)
        i += 1
    if len(pos) != 8:
        print(__doc__, file=sys.stderr)
        return 2
    pdf_path, page_s, x0, y0, x1, y1, out, expect = pos
    page_no = int(page_s)
    none_box = (float(x0), float(y0), float(x1), float(y1)) == (0.0, 0.0, 1.0, 1.0)
    x0, y0, x1, y1 = (float(v) / 1000.0 for v in (x0, y0, x1, y1))
    if not none_box and "--text" not in opts and not (0 <= x0 < x1 <= 1 and 0 <= y0 < y1 <= 1):
        return 2
    pdf = pdfium.PdfDocument(pdf_path)
    try:
        if int(expect) > 0 and len(pdf) != int(expect):
            return 3
        if not 1 <= page_no <= len(pdf):
            return 2
        img = pdf[page_no - 1].render(scale=2.0).to_pil().convert("L")
    finally:
        pdf.close()
    w, h = img.size
    if page_mode:
        # Whole page as a compact JPEG (a worked example for the transcriber).
        img.thumbnail((1100, 1500))
        img.save(out, format="JPEG", quality=72)
        return 0
    located = False
    # Prefer locating the word from the line structure of the handwriting.
    if "--text" in opts and "--offset" in opts and "--len" in opts:
        try:
            import numpy as np

            from handwriting_locate import locate_word_ex

            with open(opts["--text"], encoding="utf-8", newline="") as fh:
                text = fh.read()
            (lx0, ly0, lx1, ly1), conf, _info = locate_word_ex(
                np.asarray(img), text, int(opts["--offset"]), int(opts["--len"])
            )
            if conf >= 0.5 or (none_box and wide):
                x0, y0, x1, y1 = lx0 / 1000.0, ly0 / 1000.0, lx1 / 1000.0, ly1 / 1000.0
                none_box = False
                located = True
            elif not wide:
                return 4  # training crops are only made from a confident location
        except Exception as e:  # fall back to Claude's box (cards only)
            print("locate failed:", e, file=sys.stderr)
            if not wide:
                return 4
    show_marker = True
    if wide and not none_box and not located and (0 <= x0 < x1 <= 1 and 0 <= y0 < y1 <= 1):
        # Claude's box is only an estimate and is often a line or more off, which put the
        # yellow marker on blank paper. Snap it onto the nearest handwritten line, or draw no
        # marker at all rather than a misleading one.
        try:
            import numpy as np

            from handwriting_locate import _band_extent, find_text_lines

            arr = np.asarray(img)
            bands = find_text_lines(arr)
            cy = (y0 + y1) / 2 * h
            best = None
            for b in bands:
                if b[0] <= cy < b[1]:
                    best = b
                    break
            if best is None and bands:
                pitch = float(np.median([b[1] - b[0] for b in bands])) or 1.0
                near = min(bands, key=lambda b: abs((b[0] + b[1]) / 2 - cy))
                if abs((near[0] + near[1]) / 2 - cy) <= 1.5 * pitch:
                    best = near
            if best is None:
                show_marker = False
            else:
                y0, y1 = best[0] / h, best[1] / h
                xl, xr, _ = _band_extent(arr, best)
                x0, x1 = max(x0, xl / w), min(x1, (xr + 1) / w)
                if not x0 < x1:  # the guessed columns miss the ink: mark the whole line
                    x0, x1 = xl / w, (xr + 1) / w
        except Exception as e:
            print("snap failed:", e, file=sys.stderr)
    if none_box or not (0 <= x0 < x1 <= 1 and 0 <= y0 < y1 <= 1):
        return 4
    # Claude's boxes are approximate: pad 4% of the page width, 1.5% of the height.
    px, py = 0.04, 0.015
    if wide:
        from PIL import Image, ImageDraw

        # Claude's position guess can be a line or so off, so show generous context:
        # full width and ~7% of the page height above and below the guess (about 4-5
        # lines), with a soft translucent marker instead of a tight outline.
        pad = 0.07
        top = int(max(0.0, y0 - pad) * h)
        bottom = int(min(1.0, y1 + pad) * h)
        crop = img.crop((0, top, w, bottom)).convert("RGBA")
        rect = (
            int(max(0.0, x0 - 0.01) * w),
            int(y0 * h) - top - 3,
            int(min(1.0, x1 + 0.01) * w),
            int(y1 * h) - top + 3,
        )
        overlay = Image.new("RGBA", crop.size, (0, 0, 0, 0))
        d = ImageDraw.Draw(overlay)
        if show_marker:
            d.rectangle(rect, fill=(250, 204, 21, 70), outline=(234, 88, 12, 200), width=3)
        crop = Image.alpha_composite(crop, overlay).convert("RGB")
        crop.thumbnail((1000, 600))
        crop.save(out, format="PNG", optimize=True)
        return 0
    box = (
        int(max(0.0, x0 - px) * w),
        int(max(0.0, y0 - py) * h),
        int(min(1.0, x1 + px) * w),
        int(min(1.0, y1 + py) * h),
    )
    crop = img.crop(box)
    crop.thumbnail((MAX_W, MAX_H))
    crop.save(out, format="PNG", optimize=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
