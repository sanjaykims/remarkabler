#!/opt/renderer/bin/python
"""cropword PDF PAGE X0 Y0 X1 Y1 OUT.png EXPECT_PAGES [wide]

Crop one handwritten word out of a PDF page and save it as a small greyscale
PNG. PAGE is 1-based; the box is in thousandths of the page width/height
(Claude's rough estimate, so it is padded generously). EXPECT_PAGES guards the
page mapping: when it is > 0 and the PDF has a different number of pages
(a tall reMarkable page was sliced, say) we exit 3 instead of cropping the
wrong page. With the optional 10th argument `wide` the output is the whole line
(full page width, a little above and below) with the word's box outlined in red,
so the owner sees the surrounding words. Exit codes: 0 ok, 2 usage/bad input, 3 page-count mismatch.
"""
import sys

import pypdfium2 as pdfium

MAX_W, MAX_H = 520, 180


def main() -> int:
    wide = len(sys.argv) == 10 and sys.argv[9] == "wide"
    if len(sys.argv) not in (9, 10) or (len(sys.argv) == 10 and not wide):
        print(__doc__, file=sys.stderr)
        return 2
    pdf_path, page_s, x0, y0, x1, y1, out, expect = sys.argv[1:9]
    page_no = int(page_s)
    x0, y0, x1, y1 = (float(v) / 1000.0 for v in (x0, y0, x1, y1))
    if not (0 <= x0 < x1 <= 1 and 0 <= y0 < y1 <= 1):
        return 2
    pdf = pdfium.PdfDocument(pdf_path)
    try:
        if int(expect) > 0 and len(pdf) != int(expect):
            return 3
        if not 1 <= page_no <= len(pdf):
            return 2
        img = pdf[page_no - 1].render(scale=2.0).to_pil().convert("L")
    finally:
        pdf.close()
    w, h = img.size
    # Claude's boxes are approximate: pad 4% of the page width, 1.5% of the height.
    px, py = 0.04, 0.015
    if wide:
        from PIL import Image, ImageDraw

        # Claude's position guess can be a line or so off, so show generous context:
        # full width and ~7% of the page height above and below the guess (about 4-5
        # lines), with a soft translucent marker instead of a tight outline.
        pad = 0.07
        top = int(max(0.0, y0 - pad) * h)
        bottom = int(min(1.0, y1 + pad) * h)
        crop = img.crop((0, top, w, bottom)).convert("RGBA")
        rect = (
            int(max(0.0, x0 - 0.01) * w),
            int(y0 * h) - top - 3,
            int(min(1.0, x1 + 0.01) * w),
            int(y1 * h) - top + 3,
        )
        overlay = Image.new("RGBA", crop.size, (0, 0, 0, 0))
        d = ImageDraw.Draw(overlay)
        d.rectangle(rect, fill=(250, 204, 21, 70), outline=(234, 88, 12, 200), width=3)
        crop = Image.alpha_composite(crop, overlay).convert("RGB")
        crop.thumbnail((1000, 600))
        crop.save(out, format="PNG", optimize=True)
        return 0
    box = (
        int(max(0.0, x0 - px) * w),
        int(max(0.0, y0 - py) * h),
        int(min(1.0, x1 + px) * w),
        int(min(1.0, y1 + py) * h),
    )
    crop = img.crop(box)
    crop.thumbnail((MAX_W, MAX_H))
    crop.save(out, format="PNG", optimize=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
