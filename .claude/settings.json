{
  "extraKnownMarketplaces": {
    "sanjaykims-skills": {
      "source": {
        "source": "github",
        "repo": "sanjaykims/skills"
      }
    },
    "sanjaykims-agent-skills": {
      "source": {
        "source": "github",
        "repo": "sanjaykims/agent-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": [
    {
      "marketplace": "sanjaykims-skills",
      "plugin": "mattpocock-skills"
    },
    {
      "marketplace": "sanjaykims-agent-skills",
      "plugin": "agent-skills"
    },
    {
      "marketplace": "ponytail",
      "plugin": "ponytail"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Installing graphify + node dependencies..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/graphify_gate.py",
            "timeout": 10,
            "statusMessage": "Checking Graphify-first rule..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/graphify_mark.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
