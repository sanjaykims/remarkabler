{
  "extraKnownMarketplaces": {
    "sanjaykims-skills": {
      "source": {
        "source": "github",
        "repo": "sanjaykims/skills"
      }
    }
  },
  "enabledPlugins": [
    {
      "marketplace": "sanjaykims-skills",
      "plugin": "mattpocock-skills"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Installing graphify + node dependencies..."
          }
        ]
      }
    ]
  }
}
